# ARIA Ultra environment configuration
# Copy to .env and adjust. All values are optional — local-first defaults work as-is.

# ── Local Ollama ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=lfm2.5             # chat, research, tool calling (125K context, thinking mode)
OLLAMA_CODING_MODEL=lfm2.5           # code generation, review, debug
OLLAMA_FALLBACK_MODEL=hermes3:3b     # last-resort provider (auto-failover)
OLLAMA_EMBED_MODEL=nomic-embed-text  # embeddings for semantic memory

# ── Optional cloud provider (OpenAI-compatible) ─────────────────────
# Set all three to activate a cloud provider in the pool. It becomes a
# higher-priority option for chat/research and a fallback for code.
# Works with Groq, OpenRouter, Cerebras, Together, ... any /chat/completions.
# ULTRA_CLOUD_BASE_URL=https://api.groq.com/openai/v1
# ULTRA_CLOUD_API_KEY=gsk_...
# ULTRA_CLOUD_MODEL=llama-3.3-70b-versatile
# ULTRA_CLOUD_RPM=30

# ── Research ─────────────────────────────────────────────────────────
SEARCH_TIMEOUT_SECONDS=15
RESEARCH_MAX_SOURCES=6

# ── Paths ────────────────────────────────────────────────────────────
# ARIA4_HOME=~/.aria4
# ARIA4_PROJECTS=~/aria4_projects

# ── Runtime ──────────────────────────────────────────────────────────
ARIA4_CONTEXT=6                # conversation exchanges kept in memory
ARIA4_CMD_TIMEOUT=60           # bash tool timeout (seconds)
ARIA4_CMD_OUTPUT_CAP=10000
ARIA4_MAX_TASKS=2              # background task workers
ARIA4_TASK_TIMEOUT=600
ARIA4_MAX_BUILD_ATTEMPTS=3     # quality-gate retries per build
ARIA4_EXTRACT_SKILLS=false     # auto-learn skills after successful builds
ARIA4_SECURITY=1               # prompt-injection + code scanning gates
ARIA4_LLM_TIMEOUT=900          # max seconds per Ollama generation (deep research is slow)

# ── API server (--api) ───────────────────────────────────────────────
# Set a token to require Authorization: Bearer <token> on every request.
# Host defaults to 127.0.0.1 (localhost only). Bind 0.0.0.0 ONLY with a token set.
# ARIA4_API_TOKEN=change-me
# ARIA4_API_HOST=127.0.0.1

# ── Telegram channel ────────────────────────────────────────────────
# Get a token from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_ALLOWED_USERS=123456,789012   # comma-separated Telegram user IDs (empty = anyone)

# ── Scheduler (autonomous tasks) ────────────────────────────────────
ARIA4_SCHEDULER=false           # enable background scheduler
ARIA4_SCHEDULER_INTERVAL=30     # seconds between schedule checks

# ── Browser automation (Playwright) ─────────────────────────────────
ARIA4_BROWSER=false             # enable browser commands (browse, screenshot)
# After enabling, install: pip install playwright && playwright install chromium

# ── MCP (Model Context Protocol) ────────────────────────────────────
# Connect external tool servers. Format: name:command args,name2:command2 args2
# ARIA_MCP_SERVERS=filesystem:npx -y @modelcontextprotocol/server-filesystem /tmp
# Install MCP: pip install mcp

# ── Agent Runtime (PLAN→ACT→OBSERVE→EVALUATE→REPLAN) ───────────────
# Enable the autonomous agent loop instead of hardcoded pipelines.
# When enabled, ARIA creates plans, executes tools, observes results,
# and replans on failure — a genuine agent loop.
ARIA4_RUNTIME=false             # enable Agent Runtime (type 'runtime' in CLI to toggle)
ARIA4_RUNTIME_MAX_ITER=30       # max tool-call steps per mission
ARIA4_RUNTIME_MAX_REPLAN=5      # max replanning attempts before giving up
